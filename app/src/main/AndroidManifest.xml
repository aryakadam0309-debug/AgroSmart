<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AgroSmart"
        tools:targetApi="31">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".activities.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AgroSmart.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Language Selection -->
        <activity
            android:name=".activities.auth.LanguageSelectionActivity"
            android:exported="false" />

        <!-- Login Activity -->
        <activity
            android:name=".activities.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity -->
        <activity
            android:name=".activities.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Farmer Dashboard -->
        <activity
            android:name=".activities.farmer.FarmerDashboardActivity"
            android:exported="false" />

        <!-- Weather Forecast Module -->
        <activity
            android:name=".activities.farmer.WeatherActivity"
            android:exported="false" />

        <!-- Agriculture News Module -->
        <activity
            android:name=".activities.farmer.NewsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.farmer.NewsDetailActivity"
            android:exported="false" />

        <!-- Government Schemes Module -->
        <activity
            android:name=".activities.farmer.SchemeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.farmer.SchemeDetailActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name=".activities.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ManageSchemesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ManageNewsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ManageCropPricesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ManageTractorsActivity"
            android:exported="false" />

            <!-- Crop Prices / Mandi Bhav Activity -->
        <activity
            android:name=".activities.farmer.CropPriceActivity"
            android:exported="false" />
            <!-- Crop Guide Activities -->
        <activity android:name=".activities.farmer.CropGuideActivity" android:exported="false" />
        <activity android:name=".activities.farmer.CropGuideDetailActivity" android:exported="false" />

        <!-- Crop Disease Directory Activities -->
        <activity android:name=".activities.farmer.CropDiseaseActivity" android:exported="false" />
        <activity android:name=".activities.farmer.CropDiseaseDetailActivity" android:exported="false" />
            <!-- Tractor Booking Activities -->
        <activity android:name=".activities.farmer.TractorListActivity" android:exported="false" />
        <activity android:name=".activities.farmer.BookTractorActivity" android:exported="false" />
        <activity android:name=".activities.farmer.AddTractorActivity" android:exported="false" />
            <!-- Farm Inventory Activities -->
        <activity android:name=".activities.farmer.FertilizerInventoryActivity" android:exported="false" />
        <activity android:name=".activities.farmer.CropInventoryActivity" android:exported="false" />
            <!-- Marketplace, Cart, Checkout & Notifications Activities -->
        <activity android:name=".activities.farmer.MarketplaceActivity" android:exported="false" />
        <activity android:name=".activities.farmer.CartActivity" android:exported="false" />
        <activity android:name=".activities.farmer.OrderSuccessActivity" android:exported="false" />
        <activity android:name=".activities.farmer.NotificationsActivity" android:exported="false" />

        <!-- IoT Smart Farming & Irrigation Module Activities -->
        <activity
            android:name=".activities.farmer.IotDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.farmer.IotDeviceSetupActivity"
            android:exported="false" />

        <!-- Soil Health Advisor -->
        <activity
            android:name=".activities.farmer.SoilHealthActivity"
            android:exported="false" />

        <!-- Regional Crop Recommendation & Rotation Planner -->
        <activity
            android:name=".activities.farmer.CropRecommendationActivity"
            android:exported="false" />

        <!-- Cultivation Cost & Profitability Ledger -->
        <activity
            android:name=".activities.farmer.FarmExpensesActivity"
            android:exported="false" />

        <!-- Regional Crop Disease Outbreak Reporting -->
        <activity
            android:name=".activities.farmer.DiseaseReportActivity"
            android:exported="false" />

        <!-- Farmer Field Testing Feedback -->
        <activity
            android:name=".activities.farmer.FarmerFeedbackActivity"
            android:exported="false" />

        <!-- Admin Field Reviews & Feedback Center -->
        <activity
            android:name=".activities.admin.AdminFeedbackActivity"
            android:exported="false" />
    </application>

</manifest>
