<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/forest_green_primary"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Before You Sow"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Scientific Maharashtra Crop Plan Simulator &amp; What-If Decision Engine"
                android:textSize="12sp"
                android:textColor="#D8F3DC" />

            <!-- Tab / Segment Control -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleViewMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabSimulator"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Crop Simulator"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabSavedPlans"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="My Saved Plans"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/white" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- SIMULATOR VIEW CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerSimulatorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Farm Profile & Field Conditions Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Field &amp; Farm Conditions"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/forest_green_dark" />

                        <!-- District -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="District in Maharashtra:"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                        <Spinner
                            android:id="@+id/spnDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_spinner_border" />

                        <!-- Season & Water Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Target Season:"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnSeason"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Water Availability:"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnWater"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Land Type & Previous Crop Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Land / Elevation:"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnLandType"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Previous Crop (Rotation):"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnPreviousCrop"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Budget & Goal Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Input Budget Level:"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnBudget"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Primary Goal:"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />
                                <Spinner
                                    android:id="@+id/spnGoal"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_spinner_border" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Optional Soil Type -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Soil Type (Optional - No Lab Test Required):"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                        <Spinner
                            android:id="@+id/spnSoilType"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_spinner_border" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- WHAT-IF SIMULATOR SCENARIOS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BBF7D0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Before You Sow — What-If Stress Tests"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#166534" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Stress-test resilience before committing seeds, fertilizers, and money:"
                            android:textSize="12sp"
                            android:textColor="#15803D" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbScenarioWaterDeficit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="💧 What if water supply drops by 30%? (Drought test)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbScenarioBudgetCut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💰 What if budget is cut by 25%? (Low-cost inputs test)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbScenarioEarlyHarvest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⏱️ What if I need early harvest? (Vacate field for Rabi)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbScenarioDelayedSowing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🌧️ What if monsoon is delayed? (Late-sowing contingency)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunSimulation"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:text="🔬 Run Simulation &amp; Compare 3 Ranked Plans"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/forest_green_primary"
                    android:textColor="@color/white" />

                <!-- Loading Bar -->
                <ProgressBar
                    android:id="@+id/progressBarSimulator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <!-- Results Header -->
                <TextView
                    android:id="@+id/tvResultsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Scientific Recommendations &amp; Comparison:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/forest_green_dark"
                    android:visibility="gone" />

                <!-- Container where the 3 plan cards are inflated -->
                <LinearLayout
                    android:id="@+id/layoutPlansContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SAVED PLANS VIEW CONTAINER -->
        <LinearLayout
            android:id="@+id/containerSavedPlansView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Seasonal Crop Plans"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/forest_green_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Saved plans are stored locally and synced to backend database."
                android:textSize="12sp"
                android:textColor="@color/text_muted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSavedPlans"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvEmptySavedPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="No saved plans yet.\nRun the Crop Simulator and save your preferred seasonal plan!"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
