<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Crop Name (e.g. Tomato (टमाटर))"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Category (Vegetables, Cereals, Oilseeds)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etVariety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Variety (e.g. Hybrid Vaishnavi)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etMarketName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="APMC Market (e.g. Vashi APMC, Mumbai)"
            android:inputType="textCapWords" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="State (Maharashtra)"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etDistrict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="District (Mumbai)"
                android:inputType="textCapWords" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etMinPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Min ₹"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etMaxPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Max ₹"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etModalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Modal ₹ *"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <EditText
            android:id="@+id/etArrivals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Arrivals (e.g. 5,000 Quintals)"
            android:inputType="text" />
    </LinearLayout>
</ScrollView>
