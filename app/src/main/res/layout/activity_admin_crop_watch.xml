<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/title_crop_watch_review"
            app:titleTextColor="@color/text_primary" />

        <!-- Segmented Tab Navigation -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/adminTabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabIndicatorColor="@color/forest_green_primary"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/forest_green_primary"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_admin_reports" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_admin_clusters" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_admin_alerts" />
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ============================================== -->
        <!-- TAB 1: ALL SUBMITTED REPORTS                   -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutAdminReports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Filter Chips Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All Reports" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterPending"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Review" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterVerified"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterResolved"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resolved" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminReports"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyAdminReports"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No farmer reports found."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 2: POTENTIAL CLUSTERS                      -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutAdminClusters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Information Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FEF3C7"
                android:padding="12dp"
                android:text="🛡️ Rule-Based Cluster Detection: 3+ distinct farmer reports within 14 days in the same locality flag a potential cluster. Field verification required before publishing official alerts."
                android:textColor="#92400E"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminClusters"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyAdminClusters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No active clusters detected. Local problem reports are currently within normal variance."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 3: REGIONAL ALERTS MANAGEMENT              -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutAdminAlerts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- New Alert Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateNewAlert"
                style="@style/Widget.AgroSmart.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="📢 Publish New Regional Alert"
                app:icon="@drawable/ic_crop_watch"
                app:iconSize="18dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminAlerts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyAdminAlerts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No alerts currently published."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
