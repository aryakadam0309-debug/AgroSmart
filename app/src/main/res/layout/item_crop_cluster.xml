<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AgroSmart.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Cluster Flag Badge + Reports Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClusterStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="#FEF3C7"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="⚠️ POTENTIAL CLUSTER"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFarmersCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="3 Distinct Farmers (4 Reports)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cluster Crop & Category -->
        <TextView
            android:id="@+id/tvClusterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Soybean: Unusual Leaf Spots"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClusterLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 District: Pune (Village: Baramati) • Window: Last 14 Days"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Disclaimer -->
        <TextView
            android:id="@+id/tvClusterDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#FFFBEB"
            android:padding="8dp"
            android:text="⚠️ Multiple similar problems reported. Field inspection required. Not a confirmed outbreak."
            android:textColor="#B45309"
            android:textSize="11sp" />

        <!-- Sample Symptoms -->
        <TextView
            android:id="@+id/tvSampleSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reported symptoms: Yellow mosaic chlorosis, leaf curl, whitefly infestation."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishAlertFromCluster"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Publish Official Regional Alert"
            app:icon="@drawable/ic_crop_watch"
            app:iconSize="18dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
