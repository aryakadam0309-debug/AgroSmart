<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_warm_cream">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_leaf_logo"
        app:tint="@color/forest_green_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Order Placed Successfully! 🎉"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/forest_green_dark" />

    <TextView
        android:id="@+id/tvSuccessOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Order ID: #ORD-10023"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvSuccessSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Total: ₹2,800 • Payment: Paid via Razorpay"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Our village agri-logistics partner will deliver your inputs within 48 hours."
        android:textSize="13sp"
        android:textColor="@color/text_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToDashboard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:text="Back to Dashboard"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/forest_green_primary"
        android:textColor="@color/white" />
</LinearLayout>
