<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSavedSeasonDistrict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kharif • Pune District"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/tvSavedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23 Oct 2026"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSavedCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Soybean (Phule Sangam)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvSavedPlanType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Balanced Best Fit Plan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/forest_green_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSavedYieldCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Target: 25-30 Qtl/ha | Cost: ₹18,000/ac"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlantedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLANTED"
                android:textSize="11sp"
                app:chipBackgroundColor="#D1FAE5"
                android:textColor="#065F46"
                android:checkable="true"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSavedSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MPKV Rahuri Recommended"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />

            <ImageView
                android:id="@+id/btnDeletePlan"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete Plan" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
